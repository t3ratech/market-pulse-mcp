  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "sync-tools": "node scripts/sync-tools.mjs",
    "sync-tools:check": "node scripts/sync-tools.mjs --check",
    "verify:live": "node scripts/verify-live.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "agent-jobs",
    "agent-bounties",
    "bounties",
    "agent-marketplace",
    "market-intelligence",
    "evidence",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "vscode",
    "codex",
    "cline"
  ],
  "homepage": "https://market-pulse.t3ratech.co.zw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t3ratech/market-pulse-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/t3ratech/market-pulse-mcp/issues"
  },
  "author": "T3raTech Solutions (Pvt) Ltd",
  "files": [
    "src/",
    "agent-skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.t3ratech/market-pulse"
}
